{
  "name": "darkstone-cat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "analyze": "ANALYZE=true next build",
    "lighthouse": "node scripts/lighthouse/run-audit.mjs",
    "ludoya:check": "node scripts/ludoya/check.mjs",
    "lighthouse:local": "node scripts/lighthouse/run-audit.mjs",
    "lighthouse:prod": "node scripts/lighthouse/run-audit.mjs --prod",
    "migrate": "node scripts/migrate-members.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.99.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.4.1",
    "lenis": "^1.3.17",
    "motion": "^13.4.0",
    "next": "16.3.6",
    "next-intl": "^4.6.0",
    "nodemailer": "^10.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.5.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.4",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.0.3",
    "supabase": "^2.81.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "unrs-resolver": false
  }
}
